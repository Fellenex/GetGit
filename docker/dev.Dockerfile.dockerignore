# Ignore file for docker/dev.Dockerfile (the test image). Same context-root
# patterns as the runtime ignore, EXCEPT tests/ is deliberately kept so the
# suite ships in the image and `task test` can run pytest inside it.
.git
.github
.idea
.vscode
.pytest_cache
__pycache__/
*.pyc
*.egg-info/
build/
dist/
# Never bake the operator's token or their scraped output into the image.
.env
output/
.venv/
venv/
# Not needed to run the suite.
docs/
docker/
