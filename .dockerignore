# Keep the build context small and secrets/host artifacts out of the image.
.git
.github
.idea
.vscode
.pytest_cache
__pycache__/
*.pyc
*.egg-info/
build/
dist/
# Never bake the operator's token or their scraped output into the image.
.env
output/
.venv/
venv/
# Not needed to build or run the package.
tests/
docs/
