# Fake environment for `task test`. The dev image (docker/dev.Dockerfile) only
# runs the pytest suite, which never talks to GitHub, so these are placeholders —
# no real credentials needed. Committed on purpose (unlike .env) so tests run
# out of the box. compose loads this via `--env-file .env.tests`.
GITHUB_TOKEN=ghp_fake_token_for_tests

# Non-empty -> compose builds the dev/test image and loads this file. Keep this
# set here; keep it empty in .env for normal runs.
IS_TEST=1
