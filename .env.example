GITHUB_TOKEN=ghp_replace_me

# Leave IS_TEST empty for normal runs. Any non-empty value switches the compose
# service to the test image (docker/dev.Dockerfile) — `task test` does this via
# .env.tests, so you never set it here.
IS_TEST=

# Optional: default CLI args for `docker compose up` (ignored by `docker compose run`,
# which takes its args after the service name). Example:
# GETGIT_ARGS=octocat --max-prs 100
